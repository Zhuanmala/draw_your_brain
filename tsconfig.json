{
	"compilerOptions": {
		"target": "ES2020",
		"useDefineForClassFields": true,
		"lib": [
			"DOM",
			"DOM.Iterable",
			"ESNext"
		],
		"module": "ESNext",
		"skipLibCheck": true,
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"noEmit": true,
		"jsx": "react-jsx",
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"types": [
			"vite/client",
			"@cloudflare/workers-types"
		]
	},
	"include": [
		"src",
		"worker",
		"worker-env.d.ts",
		"vite.config.ts",
		"vite-env.d.ts"
	],
	"exclude": [
		"**/*.test.ts"
	]
}
